# MRT Station Guesser Telegram bot.
# Copy to .env on the VPS. .env is gitignored; this file never holds a value.
# Every required variable missing is reported together at startup.

# Telethon's application credentials, from https://my.telegram.org,
# API development tools. Required.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# From BotFather. Required.
TELEGRAM_BOT_TOKEN=

# The shared secret the game API expects from the bots, sent as a bearer
# token. The same value as BOT_API_TOKEN on the Vercel project. Required.
BOT_API_TOKEN=

# The "Buy Augy a Coffee" button on /start. Optional: left empty, no button.
DONATION_URL=https://donate.stripe.com/28o2akeAr3hv0DK6oo

# SUPABASE_URL and SUPABASE_SERVICE_KEY are not needed: the bot never talks
# to Supabase. Every game action goes through the API.
