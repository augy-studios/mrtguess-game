# MRT Station Guesser, the Vercel project (root directory main-site).
# Set these in Vercel, Project Settings, Environment Variables. For local
# `vercel dev`, copy to .env; .env is gitignored and never deployed.
# This file never holds a real value.

# The shared uwuapps Supabase project. Already set on the Vercel project.
# Supabase dashboard, Project Settings, Data API.
SUPABASE_URL=

# The service_role key. Bypasses row level security: used only by the
# functions in api/, never sent to a browser. Already set on the project.
SUPABASE_SERVICE_KEY=

# New for this app. The shared secret the bots send as
# `Authorization: Bearer <token>`. Any long random string, for example from
# `openssl rand -hex 32`. Put the same value in telegram-bot/.env.
BOT_API_TOKEN=

# LTA_ACCOUNT_KEY also exists on the project. This app does not use it.
