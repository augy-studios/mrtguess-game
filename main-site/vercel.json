{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "cleanUrls": true,
    "regions": ["sin1"],
    "rewrites": [{
        "source": "/",
        "destination": "/"
    }, {
        "source": "/join",
        "destination": "/"
    }, {
        "source": "/r/:id([A-Za-z0-9]{8})",
        "destination": "/"
    }]
}
